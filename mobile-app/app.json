    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.f1cockpit.app",
      "adaptiveIcon": {
        "backgroundColor": "#09090b"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "@isvend/expo-udp",
        {
          "multicast": true
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
